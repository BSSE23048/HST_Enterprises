rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    function str(d,k,n) { return d.get(k,'') is string && d.get(k,'').size() <= n; }
    function required(d,k,n) { return str(d,k,n) && d[k].size() > 0; }
    function money(n) { return n is number && n >= 0 && n <= 1000000000000; }
    function times(d) { return str(d,'createdAt',40) && str(d,'updatedAt',40); }
    function client(d) {
      return d.keys().hasOnly(['displayName','clientCode','purchaserName','businessName','phone','email','billingAddress','notes','isActive','createdAt','updatedAt','id'])
        && required(d,'displayName',200) && str(d,'clientCode',40) && str(d,'purchaserName',200)
        && str(d,'businessName',200) && str(d,'phone',40) && str(d,'email',254)
        && str(d,'billingAddress',1000) && str(d,'notes',5000) && d.isActive is bool && times(d);
    }
    function product(d) {
      return d.keys().hasOnly(['productName','description','defaultPrice','unit','isActive','createdAt','updatedAt','id'])
        && required(d,'productName',250) && str(d,'description',2000) && str(d,'unit',40)
        && money(d.defaultPrice) && d.isActive is bool && times(d);
    }
    function invoice(d) {
      return d.keys().hasOnly(['clientId','clientName','clientCode','invoiceNumber','invoiceSequence','invoiceDate','recordType','documentType','status','terms','notes','items','itemCount','subtotal','grandTotal','amountPaid','balanceDue','createdAt','updatedAt','id'])
        && required(d,'clientId',1500) && required(d,'clientName',200) && str(d,'clientCode',40)
        && required(d,'invoiceNumber',100) && d.invoiceSequence is int && d.invoiceSequence >= 0
        && d.invoiceSequence <= 1000000000 && d.invoiceDate is string && d.invoiceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.recordType in ['invoice','quotation'] && d.status in ['draft','sent','partial','paid','overdue','cancelled']
        && str(d,'terms',15000) && str(d,'notes',15000) && d.items is list && d.items.size() > 0 && d.items.size() <= 200
        && d.itemCount == d.items.size() && money(d.subtotal) && d.grandTotal == d.subtotal
        && money(d.amountPaid) && d.amountPaid <= d.grandTotal && money(d.balanceDue)
        && d.balanceDue == d.grandTotal - d.amountPaid && times(d);
    }
    match /clients/{id} { allow read, delete: if admin(); allow create, update: if admin() && client(request.resource.data); }
    match /products/{id} { allow read, delete: if admin(); allow create, update: if admin() && product(request.resource.data); }
    match /invoices/{id} { allow read, delete: if admin(); allow create, update: if admin() && invoice(request.resource.data); }
    // Signing images are provisioned through IAM by the operator, never by browsers.
    match /privateAssets/{id} { allow get: if admin(); allow list, write: if false; }
    // Public portfolio content is deployed static HTML; no public database exposure.
    match /{path=**} { allow read, write: if false; }
  }
}
